{
  "name": "toolboxlap-gateway",
  "version": "1.0.0-beta",
  "private": true,
  "description": "TOOLBOXLAP Gateway v1.0 Beta. Local Anthropic-compatible inference gateway that maps Claude-style aliases to upstream AI providers.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/main.cjs",
  "author": "TOOLBOXLAP",
  "copyright": "Copyright © 2026 TOOLBOXLAP",
  "license": "GPL-3.0-only",
  "homepage": "https://toolboxlap.com/",
  "scripts": {
    "start": "node src/server.js",
    "start:gui": "electron .",
    "build": "electron-builder",
    "postbuild": "node scripts/postbuild.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/run-tests.js all",
    "test:unit": "node scripts/run-tests.js unit",
    "test:integration": "node scripts/run-tests.js integration",
    "smoke:gmi": "node scripts/smoke-gmi.js",
    "generate:icons": "electron scripts/generate-icons.cjs",
    "check": "node --check src/server.js && node --check src/proxy.js && node --check src/config.js && node --check src/logger.js"
  },
  "build": {
    "appId": "com.toolboxlap.gateway",
    "productName": "TOOLBOXLAP Gateway",
    "artifactName": "TOOLBOXLAP-Gateway-v1.0-Beta-Portable.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "node_modules/dotenv/**/*"
    ],
    "asarUnpack": [
      "src/main.cjs"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "TOOLBOXLAP-Gateway-v1.0-Beta-Portable.exe"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
