# Local gateway listener. Keep HOST on loopback for the normal workflow.
HOST=127.0.0.1
PORT=8787

# GMI Cloud endpoint and your private GMI API credential.
GMI_BASE_URL=https://api.gmi-serving.com
GMI_API_KEY=

# Claude sees the alias; GMI receives the selected upstream model ID.
CLAUDE_MODEL_ALIAS=claude-opus-5
UPSTREAM_MODEL=MiniMaxAI/MiniMax-M3

# Optional on loopback. A non-loopback HOST requires an explicit strong token
# of at least 24 characters; the public convenience value "toolboxlap" is not
# accepted for network-visible binds.
LOCAL_GATEWAY_TOKEN=

LOG_LEVEL=info
