# Backward-compatible source/CLI defaults. Keep HOST on loopback. The desktop
# application stores settings and credentials separately for each provider.
PORT=8787
HOST=127.0.0.1

GMI_BASE_URL=https://api.gmi-serving.com
GMI_API_KEY=

CLAUDE_MODEL_ALIAS=claude-opus-5
UPSTREAM_MODEL=MiniMaxAI/MiniMax-M3

# Optional on loopback. Non-loopback binds require a strong unique token.
LOCAL_GATEWAY_TOKEN=
LOG_LEVEL=info
